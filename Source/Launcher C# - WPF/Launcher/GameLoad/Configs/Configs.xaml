<Window x:Class="GameLoad.Configs.Configs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Height="540" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FontFamily="Segoe UI"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="WinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="1"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,15,6"/>
        </Style>
        <Style x:Key="ConfigCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#CC222222"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="#CC222222"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Width="20"
                                HorizontalAlignment="Right"
                                Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#CC222222"
                                                BorderBrush="#666666"
                                                BorderThickness="1"
                                                CornerRadius="0,3,3,0">
                                            <Path x:Name="Arrow"
                                                Data="M 0 0 L 4 4 L 8 0"
                                                Fill="White"
                                                Stroke="White"
                                                StrokeThickness="0.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,2,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Border"
                                Background="#CC222222"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="8,2,0,2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        RecognizesAccessKey="True"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <TextBlock Grid.Column="1"
                                        Text="▼"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        FontSize="10"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                                <Border Background="#CC222222"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                CornerRadius="3"
                                MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="#CC222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0088FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0055AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckMarkBorder"
                                    Width="18" Height="18"
                                    CornerRadius="3"
                                    Background="#CC222222"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Margin="0,0,5,0">
                                <Path x:Name="CheckMark"
                                      Data="M 0 6 L 6 12 L 15 0"
                                      Stroke="#0088FF"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="12" Height="12"/>
                            </Border>
                            <ContentPresenter/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckMarkBorder" Property="BorderBrush" Value="#0088FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckMarkBorder" Property="BorderBrush" Value="#0088FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#CC222222"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ConfigPassword" TargetType="PasswordBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#CC222222"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Minimum" Value="30"/>
            <Setter Property="Maximum" Value="64"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0088FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="#0088FF"
                                BorderBrush="#00CCFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00AAFF"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0088FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0066CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10"
            BorderBrush="#55888888"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <Image Source="/char_right.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
            <Rectangle Fill="#CC000000"/>
            <Button x:Name="btnClose"
                    Style="{StaticResource WinBtnStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,14,0"
                    Click="btnClose_Click">
                <Image Source="/btn_close.png" Width="34" Height="34"/>
            </Button>
            <TextBlock Text="CONFIGURAÇÕES"
                       Foreground="#EEEEEE"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,45,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#0088FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>
            <Rectangle Height="2"
                       Width="300"
                       Fill="#880088FF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,85,0,0"/>
            <Grid Margin="30,110,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="CONFIGURAÇÕES GERAIS"
                                   Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolução:" Style="{StaticResource ConfigLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbResolution" Style="{StaticResource ConfigCombo}" ItemContainerStyle="{StaticResource ConfigComboItem}">
                                <ComboBoxItem Content="800 × 600 (Beta)"/>
                                <ComboBoxItem Content="1024 × 768 (Beta)"/>
                                <ComboBoxItem Content="1280 × 960 (Beta)"/>
                                <ComboBoxItem Content="1366 × 768 WidesCreen"/>
                                <ComboBoxItem Content="1440 × 900 WidesCreen"/>
                                <ComboBoxItem Content="1600 × 900 WidesCreen"/>
                                <ComboBoxItem Content="1680 × 1050 (Beta)"/>
                                <ComboBoxItem Content="1910 × 970 WidesCreen"/>
                                <ComboBoxItem Content="1920 × 1080 Full HD"/>
                                <ComboBoxItem Content="2560 × 1440 2K"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Som Efeitos:" Style="{StaticResource ConfigLabel}" Margin="0,0,9,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkSound" Style="{StaticResource ConfigCheck}" Content="Ativar" Margin="10,5,254,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Música Fundo:" Style="{StaticResource ConfigLabel}" Margin="0,0,319,0" Grid.ColumnSpan="2"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkMusic" Style="{StaticResource ConfigCheck}" Content="Ativar" Margin="10,5,244,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Modo Janela:" Style="{StaticResource ConfigLabel}" Margin="0,0,2,0"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkWindowed" Style="{StaticResource ConfigCheck}" Content="Ativar" Margin="10,5,244,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Login:" Style="{StaticResource ConfigLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtLogin" Style="{StaticResource ConfigTextBox}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Senha:" Style="{StaticResource ConfigLabel}"/>
                            <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="txtPassword" Style="{StaticResource ConfigPassword}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="chkAutoLogin" Style="{StaticResource ConfigCheck}" Content="Auto Login" FontSize="14"/>
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                            <CheckBox x:Name="chkSlideHelp" Style="{StaticResource ConfigCheck}" Content="Slide Help" Margin="0,3,20,3"/>
                            <CheckBox x:Name="chkAutoAttack" Style="{StaticResource ConfigCheck}" Content="Auto Attack" Margin="0,3,20,3"/>
                            <CheckBox x:Name="chkWhisperSound" Style="{StaticResource ConfigCheck}" Content="Whisper Sound" Margin="0,3,0,3"/>
                        </WrapPanel>
                        <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="15,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ANTI LAG"
                                   Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FPS Limit:"
                                           Style="{StaticResource ConfigLabel}"
                                           Margin="0,0,0,0"/>
                                <Slider x:Name="sldFpsLimit"
                                        Style="{StaticResource SliderStyle}"
                                        Value="60"
                                        Width="140"/>
                                <TextBlock x:Name="txtFpsValue"
                                           Text="60 FPS"
                                           Foreground="#0088FF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="OpenGL:"
                                           Style="{StaticResource ConfigLabel}"
                                           Margin="0,0,0,0"/>
                                <CheckBox x:Name="chkOpenGL"
                                          Style="{StaticResource ConfigCheck}"
                                          Content="Ativar"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,5,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkHideEffect" Style="{StaticResource ConfigCheck}" Content="Ocultar Efeitos" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chkHideParticle" Style="{StaticResource ConfigCheck}" Content="Ocultar Partículas" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkHideTerrain" Style="{StaticResource ConfigCheck}" Content="Ocultar Terreno" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkHideWings" Style="{StaticResource ConfigCheck}" Content="Ocultar Asas/Capas" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="chkHideSwords" Style="{StaticResource ConfigCheck}" Content="Ocultar Armas" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkHideSets" Style="{StaticResource ConfigCheck}" Content="Ocultar Sets" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="3" Grid.Column="0" x:Name="chkHideObjects" Style="{StaticResource ConfigCheck}" Content="Ocultar Objetos" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkHideShadows" Style="{StaticResource ConfigCheck}" Content="Ocultar Sombras" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" x:Name="chkHideMonsters" Style="{StaticResource ConfigCheck}" Content="Ocultar Monstros" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="chkHidePlayers" Style="{StaticResource ConfigCheck}" Content="Ocultar Outros Jogadores" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="5" Grid.Column="0" x:Name="chkHideNewSkill" Style="{StaticResource ConfigCheck}" Content="Remake Skills" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="chkVisualWings" Style="{StaticResource ConfigCheck}" Content="Visual Asas viram Lvl2" Margin="5,3,0,3"/>
                            <CheckBox Grid.Row="6" Grid.Column="0" x:Name="chkMiniMounts" Style="{StaticResource ConfigCheck}" Content="Mini Montarias SafeZone" Margin="0,3,5,3"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="chkHideInterface" Style="{StaticResource ConfigCheck}" Content="Ocultar HUD Interface" Margin="5,3,0,3"/>
                        </Grid>
                        <TextBlock Text="* Configurações de Anti Lag otimizam o desempenho do jogo"
                                   Foreground="#888888"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Button x:Name="btnSave"
                    Style="{StaticResource SaveButtonStyle}"
                    Content="SALVAR CONFIGURAÇÕES"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Click="btnSave_Click"/>
        </Grid>
    </Border>
</Window>