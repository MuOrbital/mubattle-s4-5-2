<Window x:Class="GameLoad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="WinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="1"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#88888888">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF4A4A4A" Offset="0"/>
                                    <GradientStop Color="#FF2A2A2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BBBBBBBB"/>
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF606060" Offset="0"/>
                                            <GradientStop Color="#FF383838" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF222222" Offset="0"/>
                                            <GradientStop Color="#FF111111" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#88888888">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF4A4A4A" Offset="0"/>
                                    <GradientStop Color="#FF2A2A2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BBBBBBBB"/>
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF606060" Offset="0"/>
                                            <GradientStop Color="#FF383838" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF222222" Offset="0"/>
                                            <GradientStop Color="#FF111111" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SocialBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" BorderBrush="#55888888" BorderThickness="1" ClipToBounds="True">
        <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <!-- Fundo -->
            <Image Source="/char_right.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Rectangle Fill="#55000000"/>
            <Rectangle VerticalAlignment="Bottom" Height="110">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#EE000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,12,0,0">
                    <Image Source="/logo_right.png" Width="75" Height="66"/>
                    <StackPanel Margin="5,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MU BATTLE" FontSize="23" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#0088FF" BlurRadius="10" ShadowDepth="3" Opacity="0.85"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="SEASON 4 CUSTOM EASY" FontSize="14" FontWeight="SemiBold" Foreground="#77CCFF" Margin="3,0,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
                    <Button x:Name="btnConfig" Style="{StaticResource WinBtnStyle}" Margin="0,0,5,0" Click="btnConfig_Click">
                        <Image Source="/btn_config.png" Width="34" Height="34"/>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{StaticResource WinBtnStyle}" Margin="0,0,5,0">
                        <Image Source="/btn_minimize.png" Width="34" Height="34"/>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource WinBtnStyle}">
                        <Image Source="/btn_close.png" Width="34" Height="34"/>
                    </Button>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,125">
                    <Button x:Name="btnSite" Style="{StaticResource MenuBtnStyle}" Content="SITE" Click="BtnLink_Click"/>
                    <Button x:Name="btnForum" Style="{StaticResource MenuBtnStyle}" Content="FORUM" Click="BtnLink_Click"/>
                    <Button x:Name="btnNoticias" Style="{StaticResource MenuBtnStyle}" Content="NOTICIAS" Click="BtnLink_Click"/>
                    <Button x:Name="btnVIP" Style="{StaticResource MenuBtnStyle}" Content="VIP" Click="BtnLink_Click"/>
                    <Button x:Name="btnDonate" Style="{StaticResource MenuBtnStyle}" Content="DONATE" Click="BtnLink_Click"/>
                    <Button x:Name="btnTools" Style="{StaticResource MenuBtnStyle}" Content="TOOLS" Click="BtnLink_Click"/>
                </StackPanel>
                
                <Grid VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="62">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#AA111111" Offset="0"/>
                                <GradientStop Color="#DD000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Button x:Name="btnFacebook" Style="{StaticResource SocialBtnStyle}" Margin="0,0,8,0" Click="BtnSocial_Click">
                                <Image Source="/icon_facebook.png" Width="28" Height="28"/>
                            </Button>
                            <Button x:Name="btnInstagram" Style="{StaticResource SocialBtnStyle}" Margin="0,0,8,0" Click="BtnSocial_Click">
                                <Image Source="/icon_instagram.png" Width="28" Height="28"/>
                            </Button>
                            <Button x:Name="btnTiktok" Style="{StaticResource SocialBtnStyle}" Margin="0,0,8,0" Click="BtnSocial_Click">
                                <Image Source="/icon_tiktok.png" Width="28" Height="28"/>
                            </Button>
                            <Button x:Name="btnYoutube" Style="{StaticResource SocialBtnStyle}" Margin="0,0,8,0" Click="BtnSocial_Click">
                                <Image Source="/icon_youtube.png" Width="28" Height="28"/>
                            </Button>
                            <Button x:Name="btnDiscord" Style="{StaticResource SocialBtnStyle}" Click="BtnSocial_Click">
                                <Image Source="/icon_discord.png" Width="28" Height="28"/>
                            </Button>
                        </StackPanel>
                        
                        <Button x:Name="btnPlay" Grid.Column="1" Style="{StaticResource PlayBtnStyle}" Width="300" Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="◆" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚔" Foreground="#CCCCCC" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="JOGAR AGORA" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="◆" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="8,0,12,0"/>
                            </Grid>
                        </Button>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">

                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Background="#EE000000" Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Versão 1.0.0.0" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Grid Grid.Column="1" Margin="12,8,12,8">
                            <Border x:Name="ProgressBarContainer" Background="#22FFFFFF" CornerRadius="3" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Border x:Name="ProgressIndicator" Width="0" HorizontalAlignment="Left" CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0088FF" Offset="0"/>
                                                <GradientStop Color="#00CCFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock x:Name="txtStatus" Text="Verificando atualizações..." Foreground="#DDDDDD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                            <TextBlock x:Name="txtPercent" Text="0.00%" Foreground="#888888" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="txtSpeed" Text="0 MB/s" Foreground="#666666" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>